# Copiar a .env y editar antes de ejecutar build.sh / docker compose up.
# Generar passwords fuertes:  openssl rand -base64 24

# === FirmaEC versión a empaquetar ===
# Selecciona qué subdir de recursos/minka/ usar (5.1, 5.2, etc.).
FIRMAEC_VERSION=5.1

# === PostgreSQL ===
FIRMAEC_DB=firmaec
FIRMAEC_DB_USER=firmaec_app
# OBLIGATORIO. Sin esto el stack no arranca. Generar con: openssl rand -base64 24
FIRMAEC_DB_PASSWORD=
# Puerto host expuesto para psql (depuración).
FIRMAEC_DB_HOST_PORT=5436

# === Nginx (punto de entrada HTTP único) ===
# Sirve cliente PHP en /, FirmaEC en /api y /servicio bajo este puerto.
NGINX_HOST_PORT=8080

# URL pública desde el navegador (mostrada en la pestaña "Endpoints" del cliente).
# Cambiar si nginx queda detrás de otro proxy externo (Traefik, dominio, etc.).
#
# IMPORTANTE: el cliente FirmaEC Desktop oficial corre en Windows host. Java
# en Windows resuelve `localhost` a `::1` (IPv6) primero, pero nginx solo
# escucha IPv4 — el Desktop falla con error de red.
# Por eso el default usa 127.0.0.1 explícito (IPv4) en lugar de localhost.
FIRMAEC_PUBLIC_BASE=http://127.0.0.1:8080

# === WildFly ===
# El puerto HTTP (8080 interno) NO se expone al host — el acceso va vía nginx.
# Solo el puerto de management (9990) queda accesible directo para depurar.
FIRMAEC_MGMT_HOST_PORT=9990
JBOSS_XMS=256m
JBOSS_XMX=2048m
JBOSS_MEM_LIMIT=4096m

# === Cliente PHP de prueba ===
# Nombre del sistema-cliente que se registra en la tabla `sistema` de FirmaEC.
FIRMAEC_CLIENT_SISTEMA=ClienteDemo

# Hash SHA-256 mayúsculas del nombre del sistema. Generar con:
#   echo -n "ClienteDemo" | sha256sum | tr a-z A-Z | awk '{print $1}'
# O usar la pestaña "Setup" en http://localhost:8080 (registro automático).
# Dejar vacío en primer arranque; completar tras Setup y reiniciar cliente-prueba.
FIRMAEC_CLIENT_API_KEY=

# === Sistema ===
TZ=America/Guayaquil
